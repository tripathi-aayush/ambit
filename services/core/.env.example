GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8000/auth/github/callback
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_KEYS_EXTRA=
OPENAI_API_KEY=
GEMINI_API_KEY=
