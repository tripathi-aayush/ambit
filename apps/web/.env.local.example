NEXT_PUBLIC_API_URL=http://localhost:8000
# Must match services/core/.env's AMBIT_API_KEY exactly. NOTE: this is
# bundled into the browser JS (NEXT_PUBLIC_*), so it's visible to anyone
# with devtools open -- fine for "shared secret, single trusted local
# operator" for now, but this is not a real secret from a hostile-browser
# perspective. See AUDIT_REPORT.md C1 / this sprint's report for context.
NEXT_PUBLIC_AMBIT_API_KEY=
